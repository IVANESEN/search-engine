# ============================================================
# MOTOR DE BUSQUEDA ICI - CONFIGURACION
# ============================================================

# Puerto del servidor
PORT=3001

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# Shopify Storefront API (publica, diferente al Admin token)
# Crear en Shopify Admin -> Settings -> Apps -> Develop apps -> Configure Storefront API
# Scopes necesarios: unauthenticated_read_product_listings
SHOPIFY_STORE_DOMAIN=icicentroamerica.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Origenes permitidos para CORS (tu dominio de Shopify y el custom)
ALLOWED_ORIGINS=https://icielsalvador.com,https://icicentroamerica.myshopify.com

# Cache: minutos antes de expirar resultados de query expansion
QUERY_CACHE_MINUTES=60

# Maximo de productos a devolver por busqueda
MAX_RESULTS=24
